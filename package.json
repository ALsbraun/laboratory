{
  "name": "laboratory",
  "version": "4.1.0",
  "description": "Because good website security shouldn't only be available to mad scientists!",
  "license": "MPL-2.0",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox && npm run compile:chrome",
    "build:chrome": "npm run compile:chrome && npm run package:chrome",
    "build:firefox": "npm run compile:firefox && npm run package:firefox",
    "compile": "npm run compile:chrome",
    "compile:chrome": "webpack --config=config/webpack.config.js --env target=chrome --mode production",
    "compile:firefox": "webpack --config=config/webpack.config.js --env target=firefox --mode production",
    "lint": "npm run lint:chrome && npm run lint:firefox && npm run compile:chrome",
    "lint:chrome": "npm run compile:chrome && node config/validate-manifests.js",
    "lint:firefox": "npm run compile:firefox && web-ext lint -s build",
    "package": "npm run package:chrome",
    "package:chrome": "web-ext build -s build -a dist --overwrite-dest --filename laboratory-chrome.zip",
    "package:firefox": "web-ext build -s build -a dist --overwrite-dest --filename laboratory-firefox.zip",
    "start": "npm run start:chrome",
    "start:chrome": "npm run compile:chrome && web-ext run --browser-console -s build -t chromium --start-url 'https://badssl.com'",
    "start:chromium": "npm run start:chrome",
    "start:firefox": "npm run compile:firefox && web-ext run --browser-console -s build -t firefox-desktop --start-url 'https://badssl.com'",
    "watch": "npm run watch:chrome",
    "watch:chrome": "webpack --config=config/webpack.config.js --env target=chrome --mode development --watch --stats-error-details --progress",
    "watch:firefox": "webpack --config=config/webpack.config.js --env target=firefox --mode development --watch --stats-error-details --progress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/april/laboratory"
  },
  "bugs": {
    "url": "https://github.com/april/laboratory/issues"
  },
  "homepage": "https://github.com/april/laboratory#readme",
  "dependencies": {
    "bootstrap": "^5.3.9",
    "clipboard": "^2.0.11",
    "jquery": "^4.0.0",
    "license-webpack-plugin": "^4.0.2",
    "localforage": "^1.10.0",
    "octicons": "^8.5.0",
    "popper.js": "^1.16.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "web-ext": "^10.8.0",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
